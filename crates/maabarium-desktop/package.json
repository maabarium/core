{
  "name": "maabarium-desktop",
  "version": "0.5.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420",
    "build": "tsc --noEmit && vite build",
    "build:release-manifest": "node ./scripts/generate-release-manifest.mjs",
    "publish:release-local": "bash ./scripts/run-local-desktop-release-r2.sh",
    "prepare:apple-certificate": "bash ./scripts/prepare-apple-certificate.sh",
    "preview": "vite preview --host 127.0.0.1 --port 1420",
    "reset:macos-production-data": "bash ./scripts/reset-macos-production-data.sh",
    "test": "vitest run",
    "test:release-local": "bash ./scripts/test-local-release-build.sh",
    "test:watch": "vitest",
    "tauri": "tauri",
    "tauri:build:dev": "tauri build --bundles app --config '{\"bundle\":{\"createUpdaterArtifacts\":false}}'",
    "tauri:build:dev:dmg": "tauri build --bundles app,dmg --config '{\"bundle\":{\"createUpdaterArtifacts\":false}}'",
    "validate:updater-keypair": "node ./scripts/validate-updater-keypair.mjs",
    "validate:updater-pubkey": "node ./scripts/validate-updater-pubkey.mjs"
  },
  "dependencies": {
    "@fontsource/azeret-mono": "^5.3.0",
    "@fontsource/m-plus-rounded-1c": "^5.3.0",
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "chart.js": "^4.6.1",
    "katex": "^0.19.1",
    "lucide-react": "^0.511.0",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.6",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.7.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^6.4.6",
    "vitest": "^4.1.12"
  }
}
